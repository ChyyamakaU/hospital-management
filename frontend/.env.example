# Copy this file to `.env` and fill in your own values.
# Vite only exposes variables that start with VITE_ to the browser code.
#
# Leave this file EMPTY during local development.
# When this is empty, the frontend calls a relative "/api" path and the Vite
# dev server proxies it to http://localhost:5000 (see vite.config.js).
#
# On Vercel, set the production value in Project Settings > Environment
# Variables, for example:
#   VITE_API_URL=https://hospital-management-api.onrender.com/api
VITE_API_URL=
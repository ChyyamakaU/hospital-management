# Copy this file to `.env` and fill in your own values.
# Never commit the real `.env` file to GitHub.

# --- Server ---
NODE_ENV=development
PORT=5000

# --- Database ---
# Prisma reads this exact variable name. For a local PostgreSQL install:
#   DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/hospital_db?schema=public"
DATABASE_URL=

# --- Authentication ---
# Generate one with:  openssl rand -base64 48
# Use a long, random value. Never commit the real one.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- CORS ---
# Comma-separated list of frontend URLs allowed to call this API.
# Local development:
CORS_ORIGIN=http://localhost:5173
# Production (replace with your real Vercel URL, no trailing slash):
# CORS_ORIGIN=https://your-app.vercel.app
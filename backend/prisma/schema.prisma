// Prisma schema for the Hospital Management System.
//
// Run `npx prisma migrate dev` after changing anything in this file.
// Prisma translates it into real PostgreSQL tables.

// The connection string comes from DATABASE_URL in backend/.env
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// What Prisma generates: the client we import in JavaScript with
// `const prisma = require('@prisma/client')`.
generator client {
  provider = "prisma-client-js"
}

/// The two roles in the system. New registrations always get PATIENT.
enum Role {
  PATIENT
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

/// Categories of ward rather than a free-text field, so filtering is reliable.
enum WardType {
  GENERAL
  MATERNITY
  PEDIATRIC
  EMERGENCY
  ICU
  SURGERY
}

/// A login account. `password` always holds a bcrypt hash, never plain text.
model User {
  id        Int      @id @default(autoincrement())
  fullName  String   @db.VarChar(120)
  email     String   @unique @db.VarChar(160)
  password  String   @db.VarChar(255)
  phone     String   @db.VarChar(30)
  address   String   @db.VarChar(255)
  role      Role     @default(PATIENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One login account may have at most one patient profile.
  patient Patient?

  @@index([role])
}

/// The hospital's patient record, created separately from the login account.
model Patient {
  id           Int      @id @default(autoincrement())
  /// Human-friendly identifier shown on reports, e.g. "PAT-000001".
  /// @unique makes the database itself reject duplicates.
  patientId    String   @unique @db.VarChar(20)
  userId       Int      @unique
  dateOfBirth  DateTime @db.Date
  gender       Gender
  bloodGroup   String?  @db.VarChar(5)
  emergencyContact String @db.VarChar(120)
  emergencyPhone   String @db.VarChar(30)
  registeredAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // The user this profile belongs to. onDelete: Cascade means deleting the
  // login account also removes the patient profile.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// A patient belongs to at most one ward. Many patients share a ward.
  wardId Int?
  ward   Ward?  @relation(fields: [wardId], references: [id], onDelete: SetNull)

  orders Order[]

  @@index([wardId])
}

model Ward {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(80)
  type        WardType @default(GENERAL)
  /// Maximum number of patients allowed at one time. Checked before assignment.
  capacity    Int
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Occupancy is not stored. It is counted from this list of patients, so the
  // number can never drift out of sync with reality.
  patients Patient[]

  @@index([type])
}

model Medicine {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(120)
  description String?  @db.VarChar(500)
  category    String   @db.VarChar(80)
  /// Decimal, not Float: floating point cannot store money exactly.
  price       Decimal  @db.Decimal(10, 2)
  stockQuantity Int    @default(0)
  /// At or below this quantity the medicine counts as "low stock".
  lowStockThreshold Int @default(10)
  expiryDate  DateTime? @db.Date
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems OrderItem[]

  @@index([category])
}

/// One purchase. The total is calculated by the backend, never by the client.
model Order {
  id          Int         @id @default(autoincrement())
  patientId   Int
  totalAmount Decimal     @db.Decimal(10, 2)
  status      OrderStatus @default(PENDING)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  patient Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  items   OrderItem[]
}

model OrderItem {
  id         Int     @id @default(autoincrement())
  orderId    Int
  medicineId Int
  quantity   Int
  /// Price copied from the Medicine at purchase time. If the shop price
  /// changes later, old orders still show what the customer actually paid.
  unitPrice  Decimal @db.Decimal(10, 2)

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  medicine Medicine @relation(fields: [medicineId], references: [id])

  @@index([medicineId])
}